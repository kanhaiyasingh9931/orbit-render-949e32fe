{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "A simple Todo application with a Vite/React frontend and an Express/Node backend.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "client:dev": "vite",
    "server:dev": "nodemon server/index.js",
    "build": "vite build --base=./"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lowdb": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "prop-types": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}